{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squishy-garden-catalog-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "CATALOG",
      "id": "CREATE_KV_NAMESPACE_AND_REPLACE_THIS_ID"
    }
  ],
  "vars": {
    "CATALOG_SOURCE_URL": "https://raw.githubusercontent.com/iamdenny/squishy-garden/main/public/catalog.json"
  },
  "triggers": {
    "crons": ["30 23 * * *"]
  }
}
